{
  "name": "bus-management-system",
  "private": true,
  "version": "2.0.0",
  "description": "A school bus route and automation management system",
  "author": "Hylith",
  "publisher": "Hylith",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "postinstall": "npm i mongodb-memory-server",
    "lint": "eslint",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.jotirmoy.busmanagementsystem",
    "productName": "Bus Management System",
    "copyright": "Copyright © 2025 ${author}",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "electron/mongodb/**"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "!**/node_modules/{@tailwindcss/oxide-wasm32-wasi,@emnapi,@tailwindcss/postcss-plugin}/**"
    ],
    "extraResources": [
      {
        "from": "electron/mongodb",
        "to": "mongodb",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/bcpsc.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@gsap/react": "^2.1.2",
    "@headlessui/react": "^2.2.4",
    "@tailwindcss/vite": "^4.1.7",
    "avro-js": "^1.12.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "framer-motion": "^12.15.0",
    "gsap": "^3.13.0",
    "locomotive-scroll": "^5.0.0-beta.21",
    "mongodb": "^6.16.0",
    "mongodb-memory-server": "^10.2.3",
    "motion": "^12.23.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.6.0",
    "sonner": "^2.0.7",
    "wait-on": "^8.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "electron": "^28.1.1",
    "electron-builder": "^24.6.4",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "postcss": "^8.5.5",
    "tailwindcss": "^4.1.10",
    "vite": "^6.3.5"
  }
}
